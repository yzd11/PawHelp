# Merge the settings you want into .env; do not replace your API/database secrets.
# Real model window from official provider; use explicit window for other models.
MODEL_CONTEXT_WINDOW=1000000
MAX_OUTPUT_TOKENS=1024
MAX_USER_INPUT_TOKENS=2000
MAX_AGENT_STEPS=3
TOOL_RESULT_MAX_TOKENS=3000
RERANK_TOP_K=5
EVIDENCE_CHUNK_MAX_TOKENS=600
CONTEXT_CHARS_PER_TOKEN=1.2
CONTEXT_TARGET_TURNS=20
CONTEXT_SAFETY_TOKENS=1000
CONTEXT_SUMMARY_MAX_TOKENS=1000
CONTEXT_LAYER2_REPLY_CHARS=60
CONTEXT_LAYER2_TOOL_TOKENS=200
CONTEXT_SUMMARY_MAX_CHARS=200
CONTEXT_SUMMARY_TIMEOUT_SECONDS=60

# Small-window cascade demo (override the above in a separate terminal):
# MODEL_CONTEXT_WINDOW=28000
