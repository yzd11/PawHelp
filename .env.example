# OpenAI-compatible chat provider. Keep actual secrets only in untracked .env.
CHAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=replace-with-provider-issued-key

# Docker MySQL development defaults (compose maps host 3307 to container 3306).
MYSQL_PORT=3307
DATABASE_URL=mysql+asyncmy://pawhelp:pawhelp_dev@127.0.0.1:3307/pawhelp?charset=utf8mb4

MODEL_TIMEOUT_SECONDS=60
CONTEXT_TOKEN_BUDGET=4096
MODEL_MAX_OUTPUT_TOKENS=1024
TOOL_TIMEOUT_SECONDS=60
TOOL_MAX_ATTEMPTS=2
STRUCTURED_OUTPUT_METHOD=json_mode
SHOP_NAME=本店

# Local business tools: start both local MCP processes before testing external tools.
MCP_ENABLED=true
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
MCP_DISCOVERY_TIMEOUT_SECONDS=3
# All three processes must use the same secret. Local demo only, not production auth.
MCP_DEMO_SECRET=local-demo-only-change-me
TOOL_POLICY_PATH=config/tool-policy.json
TOOL_PLUGINS_PATH=tool_plugins

# Local BGE-M3 and Milvus Standalone.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=1024
VECTORIZE_BATCH_SIZE=16
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=knowledge
MILVUS_HYBRID_COLLECTION=knowledge_hybrid
KNOWLEDGE_SIMILARITY_THRESHOLD=0.45
KNOWLEDGE_RERANK_THRESHOLD=0.1
DENSE_RECALL_LIMIT=50
BM25_RECALL_LIMIT=50
RERANK_LIMIT=10
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=8
RERANKER_QUERY_MAX_LENGTH=256
RERANKER_PASSAGE_MAX_LENGTH=1024
CONVERSATION_MINING_BATCH_SIZE=20

# Observability. Explicitly self-hosted; never defaults to Langfuse Cloud.
# Production observation persistence/export enabled; pytest disables this by default.
OBSERVABILITY_ENABLED=true
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Local browser operations need no token. Optional token for authenticated remote/API clients only.
ADMIN_TOKEN=
# 0 disables paid periodic work. Set nonzero only after consenting to fees.
FLYWHEEL_INTERVAL_SECONDS=0
FLYWHEEL_BATCH_SIZE=5
FLYWHEEL_CANDIDATE_LIMIT=100
EVALUATION_INTERVAL_SECONDS=0
EVALUATION_SAMPLE_PER_BUCKET=2
EVALUATION_MAX_MODEL_CALLS=100
EVIDENCE_CALIBRATION_PATH=config/evidence-calibration.json
# Evidence sufficiency judge: llm (default), shadow (Jev logged only) or jev (Jev decides
# outside its calibrated band). jev/shadow need a TypeSafe key and send question + evidence to TypeSafe.
EVIDENCE_JUDGE=llm
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=10
JEV_CALIBRATION_PATH=config/jev-evidence-calibration.json
OBSERVATION_SNAPSHOT_LIMIT=5
# Optional same-currency per-million pricing. Unknown/missing usage is not zero.
# INPUT_PRICE_PER_MILLION=
# OUTPUT_PRICE_PER_MILLION=
