# Use independently generated URL-safe random secrets; never reuse application DB credentials.
LF_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
LF_CLICKHOUSE_PASSWORD=REPLACE_WITH_RANDOM_HEX
LF_MINIO_PASSWORD=REPLACE_WITH_RANDOM_HEX
LF_REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
LF_SALT=REPLACE_WITH_RANDOM_HEX
LF_NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_HEX
# Exactly 32 random bytes represented as 64 hexadecimal characters.
LF_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
